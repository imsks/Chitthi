PORT=8080

# Auth — Go API cookie
JWT_SECRET=

# Google OAuth (NextAuth server-side; use Web application credentials in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared between Next.js (middleware) and Go API — required for browser → /api/v1/* proxy auth
CHITTHI_BFF_SECRET=

# Next.js / NextAuth (set in .env for docker-compose `web` + local `npm run dev`)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Server-side calls from Next to the Go API inside Docker (Compose sets this in docker-compose.yml)
# INTERNAL_API_URL=http://app:8080

# Optional: host port when publishing Redis (default 16379). Inside Docker, apps still use redis:6379.
# CHITTHI_REDIS_PORT=16379

# Redis config
REDIS_URL=redis://redis:6379

DATABASE_URL=postgres://postgres:postgres@db:5432/chitthi?sslmode=disable

# Platform API Keys
BREEVO_API_KEY=
MAILERSEND_API_KEY=

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

APPLICATION_NAME=chitthi