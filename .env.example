PORT=8080

# Auth — use the same Web client ID in Google Cloud (no client secret needed for ID-token flow)
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Optional: host port when publishing Redis (default 16379). Inside Docker, apps still use redis:6379.
# CHITTHI_REDIS_PORT=16379

# Redis config
REDIS_URL=redis://redis:6379

DATABASE_URL=postgres://postgres:postgres@db:5432/chitthi?sslmode=disable

# Platform API Keys
BREEVO_API_KEY=
MAILERSEND_API_KEY=

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

APPLICATION_NAME=chitthi